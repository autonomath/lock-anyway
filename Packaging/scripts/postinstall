#!/bin/zsh
set -euo pipefail

label="com.user.idle-lock"
app_executable="/Applications/Lock Anyway.app/Contents/MacOS/IdleLock"

if [[ ! -x "$app_executable" ]]; then
  echo "Lock Anyway executable was not found at $app_executable" >&2
  exit 0
fi

console_user="$(/usr/bin/stat -f '%Su' /dev/console)"
if [[ -z "$console_user" || "$console_user" == "root" || "$console_user" == "loginwindow" ]]; then
  echo "No interactive console user found; skipping LaunchAgent setup" >&2
  exit 0
fi

uid="$(/usr/bin/id -u "$console_user")"
gid="$(/usr/bin/id -g "$console_user")"
home_dir="$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory | /usr/bin/awk '{print $2}')"

if [[ -z "$home_dir" || ! -d "$home_dir" ]]; then
  echo "Could not resolve home directory for $console_user; skipping LaunchAgent setup" >&2
  exit 0
fi

launch_agents="$home_dir/Library/LaunchAgents"
logs="$home_dir/Library/Logs"
plist="$launch_agents/$label.plist"

/bin/mkdir -p "$launch_agents" "$logs"

/bin/cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$label</string>
    <key>ProgramArguments</key>
    <array>
        <string>$app_executable</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>$logs/LockAnyway.out.log</string>
    <key>StandardErrorPath</key>
    <string>$logs/LockAnyway.err.log</string>
</dict>
</plist>
PLIST

/usr/sbin/chown "$uid:$gid" "$plist" "$launch_agents" "$logs"
/bin/chmod 0644 "$plist"
/usr/bin/plutil -lint "$plist" >/dev/null

/bin/launchctl asuser "$uid" /bin/launchctl bootout "gui/$uid" "$plist" >/dev/null 2>&1 || true
/bin/launchctl asuser "$uid" /bin/launchctl bootstrap "gui/$uid" "$plist" || true
/bin/launchctl asuser "$uid" /bin/launchctl enable "gui/$uid/$label" || true

echo "Lock Anyway installed for $console_user"
